# For Uniform CLI auth
UNIFORM_API_KEY=

# Default team ID to use for Uniform CLI
UNIFORM_TEAM_ID=

# Default project ID to use for Uniform CLI
UNIFORM_PROJECT_ID=


# --- Identity delegation (used by the "Add to asset library" actions) ---
# Uniform API origin. US and EU teams use different hosts
UNIFORM_API_HOST=https://uniform.app

# From the integration's Credentials tab in Settings > Custom Integrations
# ("Generate secret"; both values are only shown once). The secret must stay server-side
UNIFORM_INTEGRATION_ID=
UNIFORM_INTEGRATION_SECRET=

# Encrypts the delegation session cookie. At least 32 bytes, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESH_SESSION_SECRET=

# Optional comma-separated HTTPS origins of this app, checked against Origin/Referer
# on state-changing requests. Defaults to https://<request host>
# MESH_ALLOWED_ORIGINS=https://localhost:9000
