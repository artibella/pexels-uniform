    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uniformdev/design-system": "20.81.1",
    "@uniformdev/mesh-sdk-react": "20.81.1",
    "next": "16.4.0",
