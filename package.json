{
  "name": "pexels-uniform",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack -p 9000",
    "build": "next build --webpack",
    "start": "next start -p 9000",
    "lint": "eslint .",
    "register-to-team": "uniform integration definition register ./mesh-manifest-production.json",
    "unregister-from-team": "uniform integration definition remove pexels",
