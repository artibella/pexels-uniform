    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uniformdev/cli": "20.81.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.4",
    "typescript": "5.6.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
